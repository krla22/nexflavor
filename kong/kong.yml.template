_format_version: "3.0"

services:
  - name: erpnext
    url: http://frontend:8080
    routes:
      - name: erp-api
        paths:
          - /api
        strip_path: false
    plugins:
      - name: request-transformer
        config:
          add:
            headers:
              - "Authorization: token ${ERP_API_KEY}:${ERP_API_SECRET}"
      - name: cors
        config:
          origins: ["*"]
          methods: [GET, POST, PUT, DELETE, OPTIONS]
          headers: [Accept, Content-Type, Authorization]
          credentials: false
